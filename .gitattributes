# Keep line endings sane across platforms: LF everywhere in the repo and in the working
# tree, CRLF only where Windows needs it. The explicit eol=lf stops git rewriting the
# files as CRLF on a Windows checkout.
* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pro text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.webp binary
